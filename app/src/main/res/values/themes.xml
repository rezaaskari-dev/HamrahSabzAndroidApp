<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base lication theme. -->
    <style name="Base.Theme.Argan" parent="Theme.MaterialComponents.DayNight.NoActionBar">


        <item name="fontFamily">@font/yekan</item>


        <!-- رنگ‌های اصلی تم -->
        <item name="colorPrimary">@color/primary</item>
        <!--
                <item name="colorPrimaryVariant">@color/primary_container</item>
        -->
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- رنگ‌های ثانویه -->
        <!--        <item name="colorSecondary">@color/secondary</item>
                <item name="colorSecondaryVariant">@color/secondary</item>-->
        <item name="colorOnSecondary">@color/on_background</item>

        <!-- وضعیت سیستم و نوارهای ناوبری -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/surface_variant</item>
        <item name="android:windowBackground">@color/background</item>


        <!-- تنظیمات مربوط به لبه‌ها و گردی (Corner Radius) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.EcoVerve.SmallComponent
        </item>
        <item name="shapeAppearanceMediumComponent">
            @style/ShapeAppearance.EcoVerve.MediumComponent
        </item>
    </style>

    <!-- تنظیمات مربوط به گردی لبه‌ها -->
    <style name="ShapeAppearance.EcoVerve.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.EcoVerve.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">24dp</item>
    </style>






    <!-- استایل برای متن‌های عنوان در کارت‌ها -->
<style name="TextAppearance.EcoVerve.CardTitle" parent="TextAppearance.MaterialComponents.Headline6">
<item name="android:textColor">@color/on_surface</item>
<item name="android:textStyle">bold</item>
<item name="android:textSize">18sp</item>
</style>

    <!-- استایل برای متن‌های توضیحات زیر عنوان -->
<style name="TextAppearance.EcoVerve.BodyMedium" parent="TextAppearance.MaterialComponents.Body2">
<item name="android:textColor">@color/on_surface</item>
<item name="android:alpha">0.7</item>
<item name="android:textSize">14sp</item>
</style><!-- استایل دکمه اصلی (Primary Button) -->
<style name="Widget.EcoVerve.Button" parent="Widget.MaterialComponents.Button">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">56dp</item>
<item name="android:insetTop">0dp</item>
<item name="android:insetBottom">0dp</item>
<item name="backgroundTint">@color/primary</item>
<item name="android:textColor">#0b1326</item>
<item name="android:textSize">16sp</item>
<item name="android:textStyle">bold</item>
<item name="cornerRadius">16dp</item>
<item name="rippleColor">#20000000</item>
</style>


    <!-- استایل دکمه ثانویه/انصراف (Outlined Button) -->
<style name="Widget.EcoVerve.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
<item name="android:layout_width">match_parent</item>
<item name="android:layout_height">56dp</item>
<item name="android:insetTop">0dp</item>
<item name="android:insetBottom">0dp</item>
<item name="strokeColor">@color/primary</item>
<item name="strokeWidth">1dp</item>
<item name="android:textColor">@color/primary</item>
<item name="android:textSize">16sp</item>
<item name="android:textStyle">bold</item>
<item name="cornerRadius">16dp</item>
</style>
    <!-- استایل‌های اختصاصی صفحه لیست قبوض -->

    <!-- پس‌زمینه کوچک دایره‌ای برای آیکون‌های داخل کارت خلاصه -->
    <style name="Widget.EcoVerve.IconContainer.Small" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_icon_circle_small</item>
        <item name="android:padding">6dp</item>
    </style>

    <!-- استایل تگ‌های وضعیت (مثل پرداخت شده یا معوقه) -->
    <style name="Widget.EcoVerve.Tag" parent="">
        <item name="android:paddingHorizontal" tools:targetApi="26">8dp</item>
        <item name="android:paddingVertical" tools:targetApi="26">2dp</item>
        <item name="android:background">@drawable/bg_tag_dark</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/yekan</item>
    </style>
    <!-- استایل‌های اختصاصی صفحه جزئیات انرژی -->







<style name="Theme.Argan" parent="Base.Theme.Argan" /></resources>